# -----------------------------------------------------------------------------
# Пример .env (без секретов)
# -----------------------------------------------------------------------------
# ВАЖНО:
# - НЕ коммитьте настоящий .env (он уже в .gitignore)
# - После изменения .env перезапустите сервис (systemd / docker / вручную)
#
# Формат списков:
# - ADMINS="123,456"
# - MANAGERS="111,222"
#
# -----------------------------------------------------------------------------

# -----------------------------
# Telegram
# -----------------------------
# Токен Telegram бота (BotFather)
TELEGRAM_BOT_TOKEN="PASTE_TELEGRAM_BOT_TOKEN_HERE"

# ID администраторов (полный доступ к меню управления)
ADMINS="123456789"

# ID менеджеров (получают уведомления о диалогах; ADMINS добавляются автоматически)
MANAGERS="123456789"

# (legacy) один менеджер, оставлено для обратной совместимости — лучше использовать MANAGERS
TELEGRAM_MANAGER_ID="0"

# -----------------------------
# Avito
# -----------------------------
# Основной account_id (user_id компании). Используется как fallback, если webhook не прислал account_id.
AVITO_ACCOUNT_ID="417713955"

# Вариант 1 (проще): один набор credentials для всех аккаунтов
AVITO_CLIENT_ID="PASTE_AVITO_CLIENT_ID_HERE"
AVITO_CLIENT_SECRET="PASTE_AVITO_CLIENT_SECRET_HERE"

# Вариант 2 (multi-account, рекомендуется): per-account credentials через JSON в env
# Пример:
# AVITO_ACCOUNTS_CREDENTIALS_JSON='{"417713955":{"client_id":"...","client_secret":"..."},"123":{"client_id":"...","client_secret":"..."}}'
AVITO_ACCOUNTS_CREDENTIALS_JSON=""

# Публичный URL, по которому Avito достучится до webhook (без слеша в конце)
# Используется для вычисления WEBHOOK_URL = PUBLIC_BASE_URL + "/avito/webhook"
PUBLIC_BASE_URL="https://example.com"

# -----------------------------
# AI / LLM (OpenAI)
# -----------------------------
OPENAI_API_KEY="PASTE_OPENAI_API_KEY_HERE"

# Модель по умолчанию
LLM_MODEL="gpt-4o"

# Температура (для моделей, которые её поддерживают)
TEMPERATURE="0.2"

# -----------------------------
# Storage / Learning
# -----------------------------
# Минимальный возраст диалога (в минутах), прежде чем он попадёт в pipeline извлечения знаний
MIN_DIALOG_AGE_MINUTES="5"

# -----------------------------
# Business metrics (опционально)
# -----------------------------
MANAGER_COST_PER_HOUR="1000"
USD_RATE="100"

# -----------------------------
# Bot behavior
# -----------------------------
# Пауза после ответа менеджера (чтобы бот не перебивал человека), минут
COOLDOWN_MINUTES_AFTER_MANAGER="15"

# -----------------------------
# Logging / Debug
# -----------------------------
# DEBUG_PROMPTS=1 печатает полный промпт в stdout (НЕ рекомендуется в проде)
DEBUG_PROMPTS="0"
